# Railway injects DATABASE_URL when this service references the PostgreSQL service.
# For local development, use a local/test PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/dukansaathi
# Generate with: openssl rand -base64 48
# Must be at least 32 characters and must be kept secret.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
